# Environment
ENV=dev

# Server ports
REST_PORT=8080
GRPC_PORT=50051
METRICS_PORT=2112

# Worker addresses
WORKER_1_REST_ADDR=localhost:8081
WORKER_2_REST_ADDR=localhost:8082
WORKER_1_GRPC_ADDR=localhost:50052
WORKER_2_GRPC_ADDR=localhost:50053

# HTTP client
HTTP_CLIENT_TIMEOUT=60s

# File size limit
MAX_FILE_SIZE_BYTES=524288000